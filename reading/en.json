    "save": "fort(?:itude)?|ref(?:lex)?|will",
    "level": "(?<level>\\s*\\+\\s*(?:caster level|cl|the caster's level|his level|her level|level))?",
    "hp": "\\s*(?:hp|hit points?|points?(?: of damage)?)?",
    "eachRound": "\\s*(?:\\/\\s*|per\\s+|each\\s+|every\\s+|a\\s+|at the (?:end|start|beginning) of (?:each|every|the)\\s+)(?:round|turn)",
    "wordBreak": "[^a-z]+"
  },
