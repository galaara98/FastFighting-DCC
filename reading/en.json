  "conditions": {
    "slay": "\\bslay|\\bdecapitat|\\binstantly killed|\\bdies instantly|\\bkilled instantly|\\bdies on the spot|\\bis slain\\b",
    "asleep": "\\b(?:falls?|fall|put|placed|sent) (?:into (?:a )?)?(?:\\w+ )?(?:asleep|sleep|slumber)|\\bsleeps?\\b",
    "paralyzed": "\\bparaly[sz]",
    "knockedOut": "\\b(?:knocked |falls? |is )?unconscious|\\bknocked out\\b(?!\\s+of\\b)|\\bsenseless\\b",
    "stunned": "\\bstun(?:ned|s)?\\b|\\bbottom of the initiative|\\bloses? (?:his |her |its |their |the )?next (?:action|attack|round|turn)|\\bdazed\\b",
    "knockedDown": "\\b(?:knocked|falls?|thrown|sent|lands?|knocks? \\w+|sweeps? \\w+|tripped)\\b(?: \\w+){0,4} (?:prone|down|to the ground|off (?:his|her|its|their) feet)|\\bprone\\b",
    "blinded": "\\bblind(?:ed|s)?\\b",
    "obeying": "\\bobeys? (?:the|a|his|her|its|their) (?:\\w+ )?command\\b|\\bmust obey\\b",
    "swayed": "\\bcharm(?:ed|s)?\\b|\\bunder (?:the caster's|his|her|your) (?:\\w+ )?control\\b|\\bas if (?:it|he|she|they) (?:were|was) (?:his|her|the caster's) (?:friend|ally)",
    "terrified": "\\b(?:frightened|terrified|flees?|fleeing|in fear|cowers?|cowering|panics?)\\b",
    "held": "\\b(?:entangled|held fast|webbed|stuck fast|immobil\\w*|can(?:not|'t) move|pinned|restrained|grappled|grapple)\\b",
    "disarmed": "\\bdisarm\\w*|\\bdrops? (?:his |her |its |their )?weapon|\\bweapon (?:is )?(?:knocked|shattered|sundered|broken|flies)",
    "slowed": "\\bslow(?:ed|s)?\\b"
  },
  "outcome": {
    "notPlainly": "\\bif\\b|\\bunless\\b|\\bsave\\b|\\bmay\\b|\\bchance\\b"
  },
  "saveVs": {
    "magical": "\\bmagic(?:al)?\\b|\\bspells?\\b",
    "poison": "\\bpoison",
    "disease": "\\bdisease",
    "frightened": "\\bfear\\b|\\bfright",
    "controlled": "\\bcharm|\\bmind",
